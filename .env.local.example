# Kopieren nach .env.local (bleibt lokal, wird nie committed) und GENAU EINE der
# beiden folgenden Variablen setzen, je nachdem, welchen Zugang du hast.
#
# Option A: eigenes Claude.ai-Abo (Pro/Max/Team/Enterprise) -- empfohlen, wenn du
# bereits mit "claude" auf deinem Rechner eingeloggt bist. Einmalig erzeugen mit:
#   docker run -it --rm ghcr.io/<owner>/bewerbungs-pipeline:latest claude setup-token
# Der Befehl gibt einen Link aus -- im eigenen Browser oeffnen und bestaetigen, das
# gedruckte Token hier eintragen (ca. 1 Jahr gueltig).
CLAUDE_CODE_OAUTH_TOKEN=

# Option B: Anthropic-Console-/API-Key (nutzungsbasierte Abrechnung statt Abo).
# Nur EINE der beiden Variablen setzen -- ist CLAUDE_CODE_OAUTH_TOKEN gesetzt, wird
# ANTHROPIC_API_KEY ignoriert.
ANTHROPIC_API_KEY=
